# Copy to .env for local work. Nothing here is needed to start: with no DATABASE_URL the server
# uses an embedded Postgres kept in DATA_DIR.

# PORT=4000

# Postgres connection string. On Vercel, Neon provides DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (for migrations).
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Where the embedded development database keeps its files.
# DATA_DIR=.data/pg

# Sites allowed to send requests that change something, separated by commas.
# ORIGINS=http://localhost:3000
